{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "endgame-countdown",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-28",

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },

  // Los 6 del equipo, separados por coma. Es la única lista: el worker valida
  // contra ella y la página dibuja los botones a partir de ella.
  // GOAL es la meta diaria de vasos por persona.
  "vars": {
    "MEMBERS": "Joaco,Jere,Maxi,Yago,Nacho,Tomi",
    "GOAL": "8",
    "TIMEZONE": "America/Argentina/Buenos_Aires"
  },

  // Reemplazá "id" por el que te devuelve:
  //   npx wrangler kv namespace create AGUA
  "kv_namespaces": [
    {
      "binding": "AGUA",
      "id": "endgame-fulbito-AGUA"
    }
  ],

  "observability": { "enabled": true }
}
